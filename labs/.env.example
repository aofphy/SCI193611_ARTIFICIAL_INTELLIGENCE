# คัดลอกไฟล์นี้เป็น .env ของตัวเอง แล้วเติมค่าลงไป
# .env อยู่ใน .gitignore แล้ว ห้าม commit ค่าจริงขึ้น git เด็ดขาด
#
# โหลดเข้าสภาพแวดล้อมด้วย   set -a; source .env; set +a
# ตรวจว่าตั้งค่าติดไหมด้วย   python llm.py

# ---------------------------------------------- ทางเลือกที่ไม่เสียเงิน
# สมัครที่ https://openrouter.ai/ แล้วสร้าง key
# รุ่นที่ลงท้ายด้วย :free ไม่คิดเงิน แต่มีเพดานจำนวนคำขอต่อนาทีและต่อวัน
OPENROUTER_API_KEY=

# ตรึงชื่อโมเดลไว้เสมอเมื่อต้องเทียบผลการทดลอง
# ดูรายชื่อที่ใช้ได้ตอนนี้ด้วย  python llm.py --free
# ถ้าไม่ตั้ง จะได้ openrouter/free ซึ่งสุ่มโมเดลใหม่ทุกคำขอ
LLM_MODEL=

# บังคับผู้ให้บริการ: openrouter, gpt, gemini, qwen, glm, kimi, local
# ถ้าไม่ตั้ง llm.py จะเลือกจาก key ที่มีในสภาพแวดล้อมให้เอง
LLM_PROVIDER=

# ---------------------------------------------- ผู้ให้บริการที่เสียเงิน
OPENAI_API_KEY=
GEMINI_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
MOONSHOT_API_KEY=
ANTHROPIC_API_KEY=

# ---------------------------------------------- โมเดลบนเครื่องตัวเอง
# Ollama ไม่ต้องใช้ key ตั้ง LLM_PROVIDER=local ก็พอ
# ติดตั้งจาก https://ollama.com แล้ว  ollama pull qwen3:8b
